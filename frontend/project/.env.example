# Backend server address (no trailing slash, no /api/v1).
# Leave unset to use the deployed Render server.
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional TURN relay for calls. Without one, calls only connect reliably when
# both people are on the same network or on simple home Wi-Fi. Mobile data,
# campus and office networks need TURN. Comma-separate several URLs.
# VITE_TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
